# Copia este archivo como ".env" y completa los valores.
# El archivo .env NO se sube a git (tiene tus contraseñas).

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers).
# Reemplaza <usuario> y <contraseña> por el usuario de base de datos que creaste.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<tu-cluster>.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (se crea sola la primera vez que se guarda una cita)
MONGODB_DB=fonomas

# Contraseña del panel /admin.html (usuario: admin)
ADMIN_PASSWORD=cambia-esta-contraseña

# Puerto del servidor
PORT=3001
